# Base URL of the API gateway. Defaults to http://localhost:8080 when unset.
VITE_API_URL=

# Google Maps Embed API key — used for the workplace mini-maps on the public card
# and the editor preview. This ships to the browser, so RESTRICT it by HTTP referrer
# in Google Cloud Console. Leave blank locally: maps fall back to a "Get directions"
# link (which needs no key). Real value only in the Vercel project env.
VITE_GOOGLE_MAPS_KEY=
